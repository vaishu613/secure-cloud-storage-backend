# AWS Configuration
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID_HERE

AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE

AWS_REGION=ap-south-1
BUCKET_NAME=your-s3-bucket-name

# Encryption Key (Base64-encoded 32 bytes for AES-256-GCM)
# If not set, the local encryption.key file will be used.
ENCRYPTION_KEY_B64=YOUR_BASE64_ENCODED_32_BYTE_KEY_HERE

# JWT Secret Key for Authentication
JWT_SECRET_KEY=your_strong_jwt_secret_key_min_32_chars_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
